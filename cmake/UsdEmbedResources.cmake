# usd_embed_resources(<out_dir> <resource_root> <schema_library>...)
#
# OpenUSD finds its file formats, asset resolver and schemas through plugInfo.json files, and reads each schema
# library's generatedSchema.usda at runtime. The extension ships as a single file, so these resources are compiled
# into it: this generates <out_dir>/usd_embedded_resources.cpp, which defines USD_EMBEDDED_RESOURCES (see
# src/include/usd_plugins.hpp) from the files the static usd overlay port installs under <resource_root>
# (<vcpkg_installed>/<triplet>/lib/usd): the plugInfo.json of ar, sdf and sdr, and both files of each schema
# library. Byte arrays rather than string literals, whose length compilers limit.
#
# Sets USD_EMBEDDED_RESOURCES_SOURCE in the caller's scope.
function(usd_embed_resources OUT_DIR RESOURCE_ROOT)
  set(RESOURCES ar/resources/plugInfo.json sdf/resources/plugInfo.json
                sdr/resources/plugInfo.json)
  foreach(SCHEMA_LIBRARY IN LISTS ARGN)
    list(APPEND RESOURCES ${SCHEMA_LIBRARY}/resources/plugInfo.json
         ${SCHEMA_LIBRARY}/resources/generatedSchema.usda)
  endforeach()

  set(OUTPUT "${OUT_DIR}/usd_embedded_resources.cpp")
  set(ARRAYS "")
  set(TABLE "")
  set(HASHES "")
  set(INDEX 0)
  foreach(RESOURCE IN LISTS RESOURCES)
    set(SOURCE "${RESOURCE_ROOT}/${RESOURCE}")
    if(NOT EXISTS "${SOURCE}")
      message(FATAL_ERROR "OpenUSD runtime resource not found: ${SOURCE}")
    endif()
    set_property(
      DIRECTORY
      APPEND
      PROPERTY CMAKE_CONFIGURE_DEPENDS "${SOURCE}")
    file(READ "${SOURCE}" HEX HEX)
    file(SHA256 "${SOURCE}" FILE_HASH)
    string(APPEND HASHES "${RESOURCE}:${FILE_HASH};")
    string(LENGTH "${HEX}" HEX_LENGTH)
    math(EXPR SIZE "${HEX_LENGTH} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
    string(APPEND ARRAYS "static const unsigned char RESOURCE_${INDEX}[] = {${BYTES}0x00};\n")
    string(APPEND TABLE "\t{\"${RESOURCE}\", RESOURCE_${INDEX}, ${SIZE}},\n")
    math(EXPR INDEX "${INDEX} + 1")
  endforeach()
  string(SHA256 CONTENT_HASH "${HASHES}")

  # built with string(APPEND): a list would treat the semicolons of the C++ code as separators
  set(CONTENT "// Generated by cmake/UsdEmbedResources.cmake - do not edit\n")
  string(APPEND CONTENT "#include \"usd_plugins.hpp\"\n\nnamespace duckdb {\n\n${ARRAYS}\n")
  string(APPEND CONTENT "extern const UsdEmbeddedResource USD_EMBEDDED_RESOURCES[] = {\n${TABLE}};\n")
  string(APPEND CONTENT "extern const idx_t USD_EMBEDDED_RESOURCE_COUNT = ${INDEX};\n")
  string(APPEND CONTENT "extern const char USD_EMBEDDED_RESOURCE_HASH[] = \"${CONTENT_HASH}\";\n\n")
  string(APPEND CONTENT "} // namespace duckdb\n")
  # only rewrite the file when its content changes, so builds stay incremental
  file(
    CONFIGURE
    OUTPUT "${OUTPUT}"
    CONTENT "${CONTENT}"
    @ONLY)
  set(USD_EMBEDDED_RESOURCES_SOURCE
      "${OUTPUT}"
      PARENT_SCOPE)
endfunction()
